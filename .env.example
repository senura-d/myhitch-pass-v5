# ─── Server-side secrets (never exposed to browser) ──────────────────────────
# Google Gemini API key — used server-side only (no NEXT_PUBLIC_ prefix).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ─── Public runtime variables (safe to expose to browser) ────────────────────
# The URL where this app is hosted.
# Prefix with NEXT_PUBLIC_ so Next.js bundles it for the client.
NEXT_PUBLIC_APP_URL="https://myhitchpass.com.au"
