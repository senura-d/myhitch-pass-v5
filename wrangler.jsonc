{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myhitch-pass-v5",
  "compatibility_date": "2026-05-31",
  "main": ".open-next/worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
